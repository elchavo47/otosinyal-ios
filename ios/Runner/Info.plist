<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>OTOSINYAL OBD2 needs Bluetooth access to connect to the ELM327 Bluetooth device in your vehicle and read engine data and trouble codes.</string>

    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>OTOSINYAL OBD2 needs Bluetooth access to connect to the ELM327 Bluetooth device in your vehicle and read engine data and trouble codes.</string>

    <key>NSLocalNetworkUsageDescription</key>
    <string>OTOSINYAL OBD2 needs local network access to communicate with your Wi-Fi OBD adapter on the same local network.</string>

    <key>NSLocationWhenInUseUsageDescription</key>
    <string>OTOSINYAL OBD2 uses your location in the performance test to compare GPS speed with the OBD vehicle speed.</string>

    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>OTOSINYAL OBD2 uses the location access you allow to compare GPS speed with vehicle speed in performance measurements.</string>

    <key>NSPhotoLibraryUsageDescription</key>
    <string>OTOSINYAL OBD2 requests access to your photo library so you can choose files and images related to your vehicle and diagnostic reports.</string>

    <key>NSCameraUsageDescription</key>
    <string>OTOSINYAL OBD2 requests camera access so you can take photos related to your vehicle or fault diagnostics.</string>

    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>

    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>tr</string>
    </array>

    <key>CFBundleDisplayName</key>
    <string>OTOSINYAL OBD2</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>otosinyal_obd2</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>

    <key>CFBundleSignature</key>
    <string>????</string>

    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <key>UIMainStoryboardFile</key>
    <string>Main</string>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>

    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <key>UIStatusBarHidden</key>
    <false/>
</dict>
</plist>
